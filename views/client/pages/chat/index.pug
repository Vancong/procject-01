extends ../../layout/default.pug
include ../../mixins/box-header.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head("Chat")
    if(user)
      .row
        .col-12
          .chat
            //- .inner-head
            //-   .inner-avatar EY
            //-   .inner-name Em Yêu
            .inner-body
              .inner-incoming
                .inner-name Em Yêu
                .inner-content
                  | A ơi sang nhà e nha, nhà e không có ai ở nhà cả
              .inner-outgoing
                .inner-content
                  | Thế à? Ok e iu
  
            .inner-foot
              form(
                class="inner-form"
                action=""
              )
                input(
                  type="text"
                  placeholder="Nhập nội dung..."
                  name="content"
                )
                button
                  i.fa-solid.fa-paper-plane